---
import Button from '@components/Button.astro';
---

<footer class="bg-surface-container-low border-t border-outline/20 px-margin">
	<div class="mx-auto px-margin py-space-xl grid gap-space-xl lg:grid-cols-12">
		<div class="lg:col-span-5 flex flex-col items-start gap-space-md">
			<h2 class="text-headline-sm font-semibold tracking-tight text-on-surface">
				Cafelia
			</h2>
			<p class="text-body-md text-on-surface-variant max-w-sm">
				Café de especialidad, desayunos, cenas y postres artesanales en dos
				locales para tomarte las tardes con calma.
			</p>
			<Button label="Reservar una mesa" />
		</div>

		<nav class="lg:col-span-7 grid gap-space-xl sm:grid-cols-3">
			<div class="flex flex-col gap-space-md">
				<p class="text-label-md uppercase text-brand-olive">Menú</p>
				<ul class="flex flex-col gap-space-sm">
					<li>
						<a class="text-body-md text-on-surface-variant hover:text-brand-caramel transition-colors" href="#menu">
							Desayunos
						</a>
					</li>
					<li>
						<a class="text-body-md text-on-surface-variant hover:text-brand-caramel transition-colors" href="#menu">
							Cenas
						</a>
					</li>
					<li>
						<a class="text-body-md text-on-surface-variant hover:text-brand-caramel transition-colors" href="#menu">
							Postres
						</a>
					</li>
					<li>
						<a class="text-body-md text-on-surface-variant hover:text-brand-caramel transition-colors" href="#menu">
							Café de especialidad
						</a>
					</li>
				</ul>
			</div>

			<div class="flex flex-col gap-space-md">
				<p class="text-label-md uppercase text-brand-olive">Horario</p>
				<ul class="flex flex-col gap-space-sm">
					<li class="text-body-md text-on-surface-variant">
						<span class="font-semibold text-on-surface">Lun - Vie</span>
						<p>7:00 - 19:00</p>
					</li>
					<li class="text-body-md text-on-surface-variant">
						<span class="font-semibold text-on-surface">Sábado</span>
						<p>8:00 - 20:00</p>
					</li>
					<li class="text-body-md text-on-surface-variant">
						<span class="font-semibold text-on-surface">Domingo</span>
						<p>9:00 - 17:00</p>
					</li>
				</ul>
			</div>

			<div class="flex flex-col gap-space-md">
				<p class="text-label-md uppercase text-brand-olive">Locales</p>
				<ul class="flex flex-col gap-space-sm">
					<li class="text-body-md text-on-surface-variant">
						<span class="font-semibold text-on-surface">Centro</span>
						<p>Av. Central 24, local 1</p>
					</li>
					<li class="text-body-md text-on-surface-variant">
						<span class="font-semibold text-on-surface">Norte</span>
						<p>Av. del Parque 108, local 4</p>
					</li>
				</ul>
			</div>
		</nav>
	</div>

	<div class="border-t border-outline/20">
		<div class="mx-auto px-margin py-space-md flex flex-wrap items-center justify-between gap-space-md">
			<p class="text-body-sm text-on-surface-variant">
				© 2026 Cafelia. Todos los derechos reservados.
			</p>
			<p class="text-label-sm uppercase text-brand-caramel">
				Café de especialidad · Hecho con calma
			</p>
		</div>
	</div>
</footer>