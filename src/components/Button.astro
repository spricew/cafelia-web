---
interface Props {
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	label?: string;
	icon?: string;
	iconSide?: 'left' | 'right';
	class?: string;
	'aria-label'?: string;
}

const {
	href,
	type = 'button',
	variant = 'primary',
	size = 'md',
	label,
	icon,
	iconSide = 'left',
	class: className = '',
	['aria-label']: ariaLabel,
} = Astro.props;

const variants = {
	primary: 'text-brand-oat bg-brand-espresso',
	secondary: 'text-brand-oat bg-brand-caramel',
	ghost: 'text-brand-dark-roast border-b-2 border-brand-caramel pb-0.5',
} as const;

const sizes = {
	sm: 'text-body-md font-medium py-2 px-3',
	md: 'text-title-md font-medium py-2 px-4',
	lg: 'text-headline-sm font-semibold py-2 px-4',
} as const;

const isGhost = variant === 'ghost';
const pill = isGhost ? '' : 'rounded-full';
const iconWrapperClass = [
	'inline-flex shrink-0 [&_svg]:h-[1.2em] [&_svg]:w-[1.2em] [&_svg]:fill-current',
	iconSide === 'right' ? 'order-2' : 'order-1',
].join(' ');
const labelClass = iconSide === 'right' ? 'order-1' : 'order-2';
const classes = [
	'inline-flex items-center justify-center w-fit gap-space-xs',
	'font-sunghyun cursor-pointer',
	sizes[size],
	pill,
	variants[variant],
	className,
].filter(Boolean).join(' ');
---

{
	href ? (
		<a href={href} class={classes} aria-label={ariaLabel ?? label}>
			{icon && <span class={iconWrapperClass} set:html={icon} />}
			{label && <span class={labelClass}>{label}</span>}
		</a>
	) : (
		<button type={type} class={classes} aria-label={ariaLabel ?? label}>
			{icon && <span class={iconWrapperClass} set:html={icon} />}
			{label && <span class={labelClass}>{label}</span>}
		</button>
	)
}