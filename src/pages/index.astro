---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<navbar class="absolute top-0 flex justify-between items-center w-full h-20 px-30 z-10"> 
		<h1 class="text-2xl font-semibold tracking-tight">Cafelia</h1>
		<ul class="flex gap-x-4 tracking-tight font-medium">
			<li>Menú</li>
			<li>Productos</li>
			<li>Servicios</li>
			<li>Nosotros</li>
			<li>Contacto</li>
		</ul>
		<span class="text-title-md font-medium tracking- py-2 px-4 rounded-full text-white bg-amber-950">Reservar</span>
	</navbar>

	<section class="flex flex-col justify-center h-full px-30">
		<h1 class="text-display-lg max-w-xl mb-6">Un cafesito o que mi rey, no lo piensas de una</h1>

		<div class="flex h-fit gap-x-2">
			<span class="w-fit text-title-md font-medium py-2 px-4 rounded-full text-white bg-amber-950">
				Reservar
			</span>
			<span class="w-fit text-title-md font-semibold py-2 px-4 rounded-full text-on-surface-variant bg-surface-container">
				Reservar
			</span>
		</div>
			

	</section>
</Layout>

<style>
	li {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	li:not(:last-child)::after {
		content: "";
		width: 1px;
		height: 1em;
		margin-left: calc(1rem + 0.5rem);
		margin-right: 0.5rem;
		background-color: currentColor;
		opacity: 0.3;
		align-self: center;
	}
</style>
