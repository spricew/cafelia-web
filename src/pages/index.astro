--- 
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import Button from '@components/Button.astro';
---

<Layout>

	<Navbar/>

	<section class="grid min-h-svh place-items-center items-center z-10">
		<div class="grid w-full max-w-7xl lg:grid-cols-12">
			<div class="lg:col-span-6 flex flex-col justify-center z-10">
				<p class="text-label-md uppercase text-brand-olive">
					Café de especialidad · Brunch artesanal
				</p>

				<h1 class="text-display-lg-mobile lg:text-display-lg text-on-surface max-w-xl mt-space-md mb-space-lg">
					El ritual del café, hecho con calma y buena leña
				</h1>

				<p class="text-body-lg text-on-surface-variant max-w-md mb-space-xl">
					Tostamos en pequeños lotes, horneamos cada mañana y servimos todo a la
					temperatura justa, en un atelier donde el tiempo va más despacio.
				</p>

				<div class="flex flex-wrap items-center gap-space-md">
					<Button label="Reservar una mesa" size='lg'/>
					<Button variant='ghost' label="Ver el menú →" size='md' />
					
				</div>
			</div>

			<div class="relative flex col-span-6 w-full h-full">
				<img src="images/test3.png" alt="" 
				class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-90 z-0 object-cover" />
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	li {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	li:not(:last-child)::after {
		content: "";
		width: 1px;
		height: 1em;
		margin-left: calc(1rem + 0.5rem);
		margin-right: 0.5rem;
		background-color: currentColor;
		opacity: 0.3;
		align-self: center;
	}
</style>