---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout>
	<navbar class="absolute top-0 flex justify-between items-center w-full h-20 px-margin z-10">
		<h1 class="text-2xl font-semibold tracking-tight text-on-surface">Cafelia</h1>
		<ul class="flex gap-x-4 tracking-tight font-medium text-on-surface">
			<li>Menú</li>
			<li>Productos</li>
			<li>Servicios</li>
			<li>Nosotros</li>
			<li>Contacto</li>
		</ul>
		<Button label="Reservar" />
	</navbar>

	<section class="grid min-h-svh items-center px-margin py-space-xl z-10">
		<div class="grid w-full max-w-7xl mx-auto gap-space-xl lg:grid-cols-12 lg:gap-mapx-margin">
			<div class="lg:col-span-6 flex flex-col justify-center z-10">
				<p class="text-label-md uppercase text-brand-olive">
					Café de especialidad · Brunch artesanal
				</p>

				<h1 class="text-display-lg-mobile lg:text-display-lg text-on-surface max-w-xl mt-space-md mb-space-lg">
					El ritual del café, hecho con calma y buena leña
				</h1>

				<p class="text-body-lg text-on-surface-variant max-w-md mb-space-xl">
					Tostamos en pequeños lotes, horneamos cada mañana y servimos todo a la
					temperatura justa, en un atelier donde el tiempo va más despacio.
				</p>

				<div class="flex flex-wrap items-center gap-space-md">
					<Button label="Reservar una mesa" size='lg'/>
					<Button variant='ghost' label="Ver el menú →" size='md' />
					
				</div>
			</div>

			<img src="images/test3.png" alt="" class="absolute top-1/2 left-1/2 -translate-x-1/8 -translate-y-1/2 h-3/4 z-0 object-cover" />
		</div>
	</section>
</Layout>

<style>
	li {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	li:not(:last-child)::after {
		content: "";
		width: 1px;
		height: 1em;
		margin-left: calc(1rem + 0.5rem);
		margin-right: 0.5rem;
		background-color: currentColor;
		opacity: 0.3;
		align-self: center;
	}
</style>